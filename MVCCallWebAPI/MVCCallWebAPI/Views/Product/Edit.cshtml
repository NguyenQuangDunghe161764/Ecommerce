@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model MVCCallWebAPI.ViewModels.ProductViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="row justify-content-center my-4">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3 d-flex align-items-center justify-content-between">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa sản phẩm</h5>
                <span class="badge bg-light text-primary">ID: #@Model.Id</span>
            </div>
            <div class="card-body p-4">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editProductForm">

                    <input type="hidden" asp-for="Id" />

                    <!-- Tên sản phẩm -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Giá bán & Kho hàng -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="Price" type="number" step="1" min="0" class="form-control" required />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label fw-bold">Số lượng kho <span class="text-danger">*</span></label>
                            <input asp-for="Stock" type="number" min="0" class="form-control" required />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Danh mục sản phẩm -->
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" class="form-select" required>
                            <option value="">-- Chọn danh mục --</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in (IEnumerable<dynamic>)ViewBag.Categories)
                                {
                                    <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Mô tả -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Quản lý hình ảnh -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Thêm hình ảnh mới</label>
                        <input type="file" id="imageInput" name="Images" multiple accept=".png,.jpg,.jpeg" class="form-control mb-3" />

                        <label class="form-label fw-bold d-block">Danh sách hình ảnh (Chọn 1 ảnh làm ảnh chính):</label>
                        <div id="preview" class="d-flex flex-wrap gap-3">

                            <!-- HÌNH ẢNH HIỆN CÓ -->
                            @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                            {
                                foreach (var img in Model.ExistingImages)
                                {
                                    <div class="image-box border p-2 rounded position-relative bg-white shadow-sm" style="width:160px;">

                                        <!-- Nút Xóa Ảnh Cũ -->
                                        <button type="button"
                                                class="btn btn-danger btn-sm position-absolute top-0 end-0 remove-image"
                                                data-image="@img"
                                                style="width:24px; height:24px; padding:0; line-height:1; border-radius:50%; transform:translate(30%,-30%);">
                                            &times;
                                        </button>

                                        <!-- Radio Chọn Ảnh Chính -->
                                        <div class="form-check text-center mb-2">
                                            <input class="form-check-input"
                                                   type="radio"
                                                   name="MainImageUrl"
                                                   value="@img"
                                                   id="main_@img.GetHashCode()"
                                            @(Model.MainImageUrl == img ? "checked='checked'" : "") />
                                            <label class="form-check-label small fw-semibold" for="main_@img.GetHashCode()">
                                                Ảnh Chính
                                            </label>
                                        </div>

                                        <!-- Tag Hiển thị -->
                                        <img src="@ApiConfig.ImageUrl(Configuration, img)"
                                             style="width:100%; height:130px; object-fit:cover; border-radius:8px;" />

                                        <div class="small text-center mt-2 text-truncate text-muted" title="@System.IO.Path.GetFileName(img)">
                                            @System.IO.Path.GetFileName(img)
                                        </div>
                                    </div>
                                }
                            }

                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="bi bi-arrow-left"></i> Hủy & Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save"></i> Cập nhật sản phẩm
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- 1. XÓA ẢNH CŨ (Tạo input hidden DeletedImages) ---
        document.addEventListener("click", function(e) {
            if (e.target.classList.contains("remove-image")) {
                const image = e.target.dataset.image;

                const hidden = document.createElement("input");
                hidden.type = "hidden";
                hidden.name = "DeletedImages";
                hidden.value = image;

                document.getElementById("editProductForm").appendChild(hidden);
                e.target.closest(".image-box").remove();
            }
        });

        // --- 2. THÊM & PREVIEW ẢNH MỚI ---
        const input = document.getElementById("imageInput");
        const preview = document.getElementById("preview");
        let selectedFiles = [];

        input.addEventListener("change", function() {
            const files = Array.from(this.files);

            // Filter chỉ nhận file ảnh
            const invalidFiles = files.filter(f => !f.type.startsWith("image/"));
            if (invalidFiles.length > 0) {
                alert("Chỉ chấp nhận các file định dạng hình ảnh!");
                this.value = "";
                return;
            }

            selectedFiles = selectedFiles.concat(files);
            renderPreview();
            updateFileInput();
        });

        function renderPreview() {
            // Xóa tất cả preview ảnh mới trước đó
            document.querySelectorAll(".new-image-box").forEach(x => x.remove());

            selectedFiles.forEach((file, index) => {
                const reader = new FileReader();

                reader.onload = function(e) {
                    const div = document.createElement("div");
                    div.className = "image-box border p-2 rounded position-relative new-image-box bg-light shadow-sm";
                    div.style.width = "160px";

                    div.innerHTML = `
                                <button type="button"
                                        class="btn btn-danger btn-sm position-absolute top-0 end-0 remove-new-image"
                                        style="width:24px; height:24px; padding:0; line-height:1; border-radius:50%; transform:translate(30%,-30%);">
                                    &times;
                                </button>

                                <div class="form-check text-center mb-2">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="MainImageUrl"
                                           value="${file.name}"
                                           id="new_main_${index}" />
                                    <label class="form-check-label small fw-semibold" for="new_main_${index}">
                                        Ảnh Chính
                                    </label>
                                </div>

                                <img src="${e.target.result}" style="width:100%; height:130px; object-fit:cover; border-radius:8px;" />

                                <div class="small text-center mt-2 text-truncate text-muted" title="${file.name}">
                                    ${file.name}
                                </div>
                            `;

                    preview.appendChild(div);

                    // Bắt sự kiện xóa ảnh mới chính xác theo index
                    div.querySelector(".remove-new-image").addEventListener("click", function() {
                        selectedFiles = selectedFiles.filter((_, i) => i !== index);
                        updateFileInput();
                        renderPreview();
                    });
                };

                reader.readAsDataURL(file);
            });
        }

        function updateFileInput() {
            const dataTransfer = new DataTransfer();
            selectedFiles.forEach(file => {
                dataTransfer.items.add(file);
            });
            input.files = dataTransfer.files;
        }
    </script>
}