@model MVCCallWebAPI.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme-mocha.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="auth-card">

                @* --- Header --- *@
                <div class="auth-header">
                    <div class="mb-2">
                        <i class="bi bi-key-fill display-5" style="color: #C9A96E;"></i>
                    </div>
                    <h3 class="auth-header-title mb-1">ĐỔI MẬT KHẨU</h3>
                    <p class="auth-header-sub mb-0">Cập nhật mật khẩu để bảo vệ tài khoản của bạn</p>
                </div>

                @* --- Body Form --- *@
                <div class="p-4 p-md-5">

                    @* Hiển thị thông báo Success *@
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-mocha-success d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
                            <div>@TempData["Success"]</div>
                        </div>
                    }

                    @* Hiển thị thông báo Error từ TempData *@
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-mocha-danger d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                            <div>@TempData["Error"]</div>
                        </div>
                    }

                    @* Hiển thị thông báo Error từ ViewBag *@
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-mocha-danger d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                            <div>@ViewBag.Error</div>
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post" class="d-flex flex-column gap-3">
                        @Html.AntiForgeryToken()

                        @* Current Password *@
                        <div>
                            <label asp-for="CurrentPassword" class="form-label form-label-mocha">Mật khẩu hiện tại</label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-lock-fill input-icon"></i>
                                <input asp-for="CurrentPassword"
                                       type="password"
                                       class="form-control form-control-mocha"
                                       placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        @* New Password *@
                        <div>
                            <label asp-for="NewPassword" class="form-label form-label-mocha">Mật khẩu mới</label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-shield-lock-fill input-icon"></i>
                                <input asp-for="NewPassword"
                                       type="password"
                                       class="form-control form-control-mocha"
                                       placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        @* Confirm Password *@
                        <div>
                            <label asp-for="ConfirmPassword" class="form-label form-label-mocha">Xác nhận mật khẩu mới</label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-shield-check input-icon"></i>
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control form-control-mocha"
                                       placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        @* Submit Button *@
                        <button type="submit" class="btn btn-mocha-primary w-100 mt-3 d-flex align-items-center justify-content-center gap-2">
                            <span>Cập Nhật Mật Khẩu</span>
                            <i class="bi bi-arrow-repeat fs-5"></i>
                        </button>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}