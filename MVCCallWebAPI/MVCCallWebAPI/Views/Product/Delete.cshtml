@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model MVCCallWebAPI.ViewModels.ProductViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa sản phẩm";
    var mainImage = !string.IsNullOrEmpty(Model.MainImageUrl)
        ? ApiConfig.ImageUrl(Configuration, Model.MainImageUrl)
        : "https://via.placeholder.com/150?text=No+Image";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-danger rounded-3">

            <!-- Header Warning -->
            <div class="card-header bg-danger text-white py-3 d-flex align-items-center justify-content-between">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa sản phẩm
                </h5>
                <span class="badge bg-light text-danger">ID: #@Model.Id</span>
            </div>

            <div class="card-body p-4">

                <!-- Danger Alert Message -->
                <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill fs-4 me-3 flex-shrink-0"></i>
                    <div>
                        <strong>Hành động này không thể hoàn tác!</strong> Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm này khỏi hệ thống?
                    </div>
                </div>

                <!-- Product Summary Preview -->
                <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@mainImage"
                             alt="@Model.Name"
                             class="rounded border bg-white object-fit-cover"
                             width="90"
                             height="90" />

                        <div class="flex-grow-1">
                            <h5 class="fw-bold text-dark mb-1">@Model.Name</h5>
                            <div class="text-danger fw-bold fs-6 mb-1">
                                @Model.Price.ToString("N0") VNĐ
                            </div>
                            <div class="small text-muted d-flex gap-3">
                                <span><i class="bi bi-box-seam me-1"></i>Kho: <strong>@Model.Stock</strong></span>
                                @if (Model.Category != null)
                                {
                                    <span><i class="bi bi-folder me-1"></i>Danh mục: <strong>@Model.Category.Name</strong></span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation Form -->
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            <i class="bi bi-trash-fill me-1"></i> Xóa sản phẩm
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>