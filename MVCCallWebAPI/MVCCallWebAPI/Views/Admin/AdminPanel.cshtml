@using Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<MVCCallWebAPI.ViewModels.RoleViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Quyền";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-3 mb-4 border-bottom">
        <h3 class="fw-bold mb-0 luxury-accent">
            <i class="bi bi-shield-lock-fill me-2"></i>Danh sách Quyền hệ thống
        </h3>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="ps-4 py-3">Tên Role (Role Name)</th>
                        <th scope="col" class="py-3 text-center pe-4" style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-heading fs-6">@role.Name</span>
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-controller="Admin"
                                       asp-action="ManageRolePermissions"
                                       asp-route-roleId="@role.Id"
                                       class="btn btn-sm btn-primary px-3 fw-medium">
                                        <i class="bi bi-gear-fill me-1"></i> Phân quyền
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted py-5">
                                <i class="bi bi-exclamation-circle fs-2 d-block mb-2"></i>
                                Không tìm thấy quyền nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>