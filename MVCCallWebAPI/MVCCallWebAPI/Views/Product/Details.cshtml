@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model MVCCallWebAPI.ViewModels.ProductViewModel

@{
    ViewData["Title"] = Model.Name;
    var mainImage = !string.IsNullOrEmpty(Model.MainImageUrl)
        ? ApiConfig.ImageUrl(Configuration, Model.MainImageUrl)
        : "https://via.placeholder.com/500x500?text=No+Image";
}

<style>
    /* Ẩn mũi tên lên xuống mặc định của input type="number" */
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
    }
    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<div class="container py-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Product" asp-action="Index" class="text-decoration-none text-muted">Sản phẩm</a>
            </li>
            @if (Model.Category != null)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none text-muted">
                        @Model.Category.Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active text-truncate text-heading fw-semibold" style="max-width: 250px;" aria-current="page">
                @Model.Name
            </li>
        </ol>
    </nav>

    <div class="card p-3 p-md-4">
        <div class="row g-4">

            <!-- BÊN TRÁI: GALLERY HÌNH ẢNH -->
            <div class="col-md-5">

                <!-- MAIN IMAGE -->
                <div class="border border-secondary rounded-3 p-2 text-center position-relative d-flex align-items-center justify-content-center overflow-hidden" 
                     style="min-height: 380px; background-color: rgba(0, 0, 0, 0.2);">
                    <img id="mainImage"
                         src="@mainImage"
                         alt="@Model.Name"
                         class="img-fluid rounded"
                         style="max-height: 420px; object-fit: contain;" />
                </div>

                <!-- THUMBNAILS -->
                @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mt-3 justify-content-start" id="thumbnailContainer">
                        @foreach (var img in Model.ExistingImages)
                        {
                            var imgUrl = ApiConfig.ImageUrl(Configuration, img);
                            <img src="@imgUrl"
                                 class="border border-secondary rounded thumb-image @(img == Model.MainImageUrl ? "border-warning" : "")"
                                 width="75"
                                 height="75"
                                 style="object-fit: cover; cursor: pointer; opacity: 0.8; transition: opacity 0.2s, border-color 0.2s;"
                                 onclick="changeMainImage(this)"
                                 onmouseover="this.style.opacity='1'"
                                 onmouseout="if(!this.classList.contains('border-warning')) this.style.opacity='0.8'" />
                        }
                    </div>
                }

            </div>

            <!-- BÊN PHẢI: THÔNG TIN SẢN PHẨM -->
            <div class="col-md-7 d-flex flex-column">

                <!-- Category Badge -->
                @if (Model.Category != null)
                {
                    <div class="mb-2">
                        <span class="badge bg-dark text-light border border-secondary px-3 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-tag-fill me-1 luxury-accent"></i>@Model.Category.Name
                        </span>
                    </div>
                }

                <!-- Tên Sản Phẩm -->
                <h2 class="fw-bold text-heading mb-3">@Model.Name</h2>

                <!-- Giá Sản Phẩm -->
                <div class="p-3 rounded-3 mb-3 d-flex align-items-baseline gap-2 border border-secondary" 
                     style="background-color: rgba(0, 0, 0, 0.2);">
                    <span class="luxury-accent fw-bold fs-2">@Model.Price.ToString("N0")</span>
                    <span class="fs-5 fw-bold text-muted">VNĐ</span>
                </div>

                <!-- Tình Trạng Hàng -->
                <div class="mb-3 d-flex align-items-center gap-2">
                    <strong class="text-muted">Tình trạng:</strong>
                    @if (Model.Stock > 0)
                    {
                        <span class="badge bg-success-subtle text-success px-2 py-1 border border-success-subtle">
                            <i class="bi bi-check-circle-fill me-1"></i>Còn hàng 
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger px-2 py-1 border border-danger-subtle">
                            <i class="bi bi-x-circle-fill me-1"></i>Hết hàng
                        </span>
                    }
                </div>

                <!-- Mô Tả -->
                <div class="mb-4 flex-grow-1">
                    <h6 class="fw-bold text-heading border-bottom border-secondary pb-2">Mô tả sản phẩm</h6>
                    <p class="text-muted lh-base mt-2" style="white-space: pre-line;">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả chi tiết cho sản phẩm này." : Model.Description)
                    </p>
                </div>

                <!-- Chọn Số Lượng & Các Nút Thao Tác -->
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-auto pt-3 border-top border-secondary">
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- 1. Nút Quay lại -->
                        <a asp-controller="Product" asp-action="Index" 
                           class="btn btn-outline-secondary btn-lg d-flex align-items-center justify-content-center px-3" 
                           title="Quay lại danh sách">
                            <i class="bi bi-arrow-left"></i>
                        </a>

                        <!-- 2. Ô Tăng/Giảm số lượng -->
                        <div class="input-group" style="width: 130px;">
                            <button type="button" class="btn btn-outline-secondary" onclick="updateQuantity(-1)">-</button>
                            <input type="number" id="quantityInput" name="quantity" 
                                   class="form-control text-center border-secondary fw-bold" 
                                   value="1" min="1" max="@Model.Stock" @(Model.Stock <= 0 ? "disabled" : "") />
                            <button type="button" class="btn btn-outline-secondary" onclick="updateQuantity(1)">+</button>
                        </div>

                        <!-- 3. Nút Thêm vào giỏ hàng -->
                        <button type="submit" 
                                class="btn btn-primary btn-lg flex-grow-1 d-flex align-items-center justify-content-center gap-2" 
                                @(Model.Stock <= 0 ? "disabled" : "")>
                            <i class="bi bi-cart-plus-fill"></i>
                            <span>Thêm vào giỏ hàng</span>
                        </button>
                    </div>
                </form>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Xử lý đổi ảnh chính và highlight border thumbnail
        function changeMainImage(element) {
            document.getElementById("mainImage").src = element.src;

            // Remove highlight khỏi tất cả thumbnail
            document.querySelectorAll(".thumb-image").forEach(img => {
                img.classList.remove("border-warning");
            });

            // Highlight thumbnail đang chọn
            element.classList.add("border-warning");
        }

        // Xử lý nút tăng giảm số lượng
        function updateQuantity(change) {
            const input = document.getElementById("quantityInput");
            if (!input || input.disabled) return;

            let currentVal = parseInt(input.value) || 1;
            let maxVal = parseInt(input.getAttribute("max")) || 999;

            let newVal = currentVal + change;
            if (newVal >= 1 && newVal <= maxVal) {
                input.value = newVal;
            }
        }
    </script>
}