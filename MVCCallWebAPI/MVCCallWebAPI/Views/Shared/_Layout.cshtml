@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVCCallWebAPI</title>

    @* Google Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    @* Bootstrap 5 CSS & Bootstrap Icons *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @* Theme CSS *@
    <link rel="stylesheet" href="~/css/theme-override.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVCCallWebAPI.styles.css" asp-append-version="true" />

    @* Hứng các file CSS riêng từ view con *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-mocha sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cpu-fill" style="-webkit-text-fill-color: initial; color: var(--primary-gold);"></i>
                    <span>MVCCallWebAPI</span>
                </a>

                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCyberContent" aria-controls="navbarCyberContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2" style="color: var(--primary-gold);"></i>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between" id="navbarCyberContent">

                    @{
                        var jwtToken = HttpContextAccessor.HttpContext?.Session.GetString("JWT");
                        var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
                        var userRole = HttpContextAccessor.HttpContext?.Session.GetString("Role");
                    }

                    <ul class="navbar-nav my-2 my-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-grid"></i> Sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cart-link d-flex align-items-center gap-1" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3"></i> Giỏ hàng
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(jwtToken))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link user-pill d-flex align-items-center gap-2 dropdown-toggle"
                                   href="#"
                                   id="userDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5" style="color: var(--primary-gold);"></i>
                                    <span>@userName</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-mocha shadow" aria-labelledby="userDropdown">
                                    <li class="px-3 py-1 text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tài khoản</li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Account" asp-action="EditProfile">
                                            <i class="bi bi-person-vcard"></i> Thông tin cá nhân
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Address" asp-action="Index">
                                            <i class="bi bi-geo-alt"></i> Địa chỉ giao hàng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-key"></i> Đổi mật khẩu
                                        </a>
                                    </li>

                                    @if (userRole == "Admin")
                                    {
                                        <li><hr class="dropdown-divider my-2"></li>
                                        <li class="px-3 py-1 text-danger small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Quản trị</li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2 text-danger" asp-controller="Admin" asp-action="Roles">
                                                <i class="bi bi-shield-lock text-danger"></i> Admin Panel
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider my-2"></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 text-secondary" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn-auth-login" asp-controller="Account" asp-action="Login">
                                    Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-auth-register" asp-controller="Account" asp-action="Register">
                                    Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">

        @* Thông báo Success / Error từ Controller nếu có *@
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @* Debug Info UI *@
        @if (TempData["LoginDebug"] != null)
        {
            <div class="debug-box p-3 mb-4 shadow-sm position-relative">
                <div class="d-flex align-items-center gap-2 mb-1 text-warning-emphasis fw-bold">
                    <i class="bi bi-bug-fill"></i> Debug Response
                </div>
                <pre class="mb-0 small text-dark p-2 bg-white rounded border" style="white-space:pre-wrap; max-height: 120px; overflow-y: auto;">@TempData["LoginDebug"]</pre>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-mocha text-center py-3 border-top">
        <div class="container">
            <span class="small">&copy; @DateTime.Now.Year - <strong>MVCCallWebAPI</strong>. Obsidian Mocha & Champagne Gold Concept.</span>
        </div>
    </footer>

    @* Scripts *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>