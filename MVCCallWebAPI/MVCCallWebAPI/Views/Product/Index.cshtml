@using Microsoft.AspNetCore.Http
@using MVCCallWebAPI.Helpers
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model PagedResult<MVCCallWebAPI.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("Role");
    var jwt = HttpContextAccessor.HttpContext?.Session.GetString("JWT");
    var canCreate = userRole == "Admin" ||
        (!string.IsNullOrEmpty(jwt) && JwtHelper.HasPermission(jwt, "Product.Create"));
}

<div class="container py-4">

    @* --- Header Section --- *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1 luxury-accent">Sản Phẩm Nổi Bật</h2>
            <p class="text-muted small mb-0">Khám phá danh sách các thiết bị & công nghệ mới nhất.</p>
        </div>

        @if (canCreate)
        {
            <div>
                <a asp-controller="Product" asp-action="Create" class="btn btn-primary fw-bold d-inline-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Thêm Sản Phẩm</span>
                </a>
            </div>
        }
    </div>

    @* --- Filter & Search Section --- *@
    <div class="card p-3 p-md-4 mb-4">
        <form method="get" class="row g-3 align-items-center">

            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="keyword"
                           value="@ViewBag.Keyword"
                           class="form-control border-start-0"
                           placeholder="Tìm kiếm sản phẩm..." />
                </div>
            </div>

            <div class="col-12 col-md-4">
                <select name="categoryId" class="form-select">
                    <option value="">Tất cả danh mục</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in (IEnumerable<dynamic>)ViewBag.Categories)
                        {
                            <option value="@category.Id" selected="@(ViewBag.CategoryId == category.Id)">
                                @category.Name
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-funnel-fill"></i>
                    <span>Lọc sản phẩm</span>
                </button>

                @if (!string.IsNullOrEmpty(ViewBag.Keyword as string) || ViewBag.CategoryId != null)
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary d-flex align-items-center" title="Xóa bộ lọc">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }
            </div>

        </form>
    </div>

    @* --- Product Grid Section --- *@
    @if (Model != null && Model.Items != null && Model.Items.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
            @foreach (var item in Model.Items)
            {
                <div class="col">
                    <div class="card h-100 overflow-hidden">

                        @* Image & Category Badge *@
                        <div class="position-relative w-100 overflow-hidden" style="padding-top: 75%; background-color: rgba(0,0,0,0.2);">
                            @if (!string.IsNullOrEmpty(item.MainImageUrl))
                            {
                                <img src="@ApiConfig.ImageUrl(Configuration, item.MainImageUrl)"
                                     alt="@item.Name"
                                     class="position-absolute top-0 start-0 w-100 h-100"
                                     style="object-fit: cover;" />
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted position-absolute top-0 start-0 w-100">
                                    <i class="bi bi-image fs-1 opacity-50"></i>
                                    <span class="small">Chưa có ảnh</span>
                                </div>
                            }

                            @if (item.Category != null)
                            {
                                <span class="badge bg-dark text-light border border-secondary position-absolute top-0 start-0 m-2 px-2 py-1 small">
                                    @item.Category.Name
                                </span>
                            }
                        </div>

                        @* Card Body *@
                        <div class="p-3 d-flex flex-column flex-grow-1">

                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="text-decoration-none text-heading fw-bold mb-2 text-truncate-2"
                               style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 2.8em;"
                               title="@item.Name">
                                @item.Name
                            </a>

                            <div class="d-flex align-items-center justify-content-between mb-3 mt-auto">
                                <div class="luxury-accent fw-bold fs-5">
                                    @item.Price.ToString("N0") <span class="fs-6 fw-normal">đ</span>
                                </div>

                                <div>
                                    @if (item.Stock > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            Kho: @item.Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            Hết hàng
                                        </span>
                                    }
                                </div>
                            </div>

                            @* Add to Cart Button *@
                            <a asp-controller="Cart"
                               asp-action="AddToCart"
                               asp-route-productId="@item.Id"
                               class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-2 mt-auto">
                                <i class="bi bi-cart-plus fs-5"></i>
                                <span>Thêm vào giỏ</span>
                            </a>

                        </div>

                    </div>
                </div>
            }
        </div>

        @* --- Pagination Section --- *@
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-4">
                <nav aria-label="Product pagination">
                    <ul class="pagination pagination-sm mb-0">

                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.Page - 1, keyword = ViewBag.Keyword, categoryId = ViewBag.CategoryId })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, keyword = ViewBag.Keyword, categoryId = ViewBag.CategoryId })">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.Page + 1, keyword = ViewBag.Keyword, categoryId = ViewBag.CategoryId })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        @* --- Empty State UI --- *@
        <div class="card text-center py-5 my-4 p-4 border-0">
            <div class="mb-3">
                <i class="bi bi-box-seam display-1 luxury-accent opacity-75"></i>
            </div>
            <h4 class="fw-bold mb-2 text-heading">Không tìm thấy sản phẩm nào</h4>
            <p class="text-muted mb-4">Thử thay đổi từ khóa tìm kiếm hoặc chọn danh mục khác xem sao nhé.</p>
            <a href="@Url.Action("Index")" class="btn btn-primary px-4">
                Xem tất cả sản phẩm
            </a>
        </div>
    }

</div>