@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userName = HttpContextAccessor.HttpContext?.Session?.GetString("UserName") ?? "Admin";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <!-- CSS Files -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar Admin -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-mocha">
            <div class="container-fluid">
                <!-- Brand -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i>MVCCallWebAPI
                </a>

                <!-- User Controls -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav align-items-center gap-2">

                        <!-- User Dropdown -->
                        <li class="nav-item">
                            <div class="dropdown">
                                <a class="nav-link user-pill dropdown-toggle d-flex align-items-center"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 me-2 luxury-accent"></i>
                                    <span>@userName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-mocha dropdown-menu-end mt-2">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="EditProfile">
                                            <i class="bi bi-person-lines-fill me-2"></i>Thông tin cá nhân
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-key-fill me-2"></i>Đổi mật khẩu
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>

                        <!-- Logout Button -->
                        <li class="nav-item">
                            <a class="btn btn-outline-danger btn-sm rounded-pill px-3" asp-area="" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block border-end p-0">
                <div class="p-3">
                    <h6 class="text-muted px-2 mb-3 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.8px;">
                        Chức năng quản lý
                    </h6>
                    <ul class="nav flex-column gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Roles">
                                <i class="bi bi-shield-lock me-2 luxury-accent"></i>Quản lý Roles
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                <i class="bi bi-people me-2 luxury-accent"></i>Người dùng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Products">
                                <i class="bi bi-box-seam me-2 luxury-accent"></i>Sản phẩm
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content Area -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 pt-4 pb-5">
                <div class="card p-4">
                    @RenderBody()
                </div>
            </main>

        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>