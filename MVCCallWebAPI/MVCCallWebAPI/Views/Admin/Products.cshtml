@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model PagedResult<MVCCallWebAPI.ViewModels.ProductViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container-fluid">
    <!-- Header Page -->
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-3 mb-4 border-bottom">
        <h3 class="fw-bold mb-0 luxury-accent">
            <i class="bi bi-box-seam-fill me-2"></i>Quản lý danh sách sản phẩm
        </h3>
        <a class="btn btn-primary fw-bold px-3"
           asp-controller="Product"
           asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm mới
        </a>
    </div>

    <!-- Table Card Wrapper -->
    <div class="card shadow-sm border-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="ps-4 py-3" style="width: 90px;">Hình ảnh</th>
                        <th scope="col" class="py-3">Tên sản phẩm</th>
                        <th scope="col" class="py-3">Danh mục</th>
                        <th scope="col" class="py-3 text-end">Đơn giá</th>
                        <th scope="col" class="py-3 text-center">Tồn kho</th>
                        <th scope="col" class="py-3 text-center pe-4" style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Items != null && Model.Items.Any())
                    {
                        foreach (var p in Model.Items)
                        {
                            <tr>
                                <!-- Image Column -->
                                <td class="ps-4 py-2">
                                    @if (!string.IsNullOrEmpty(p.MainImageUrl))
                                    {
                                        <img src="@ApiConfig.ImageUrl(Configuration, p.MainImageUrl)"
                                             alt="@p.Name"
                                             class="rounded-3 border"
                                             width="60"
                                             height="60"
                                             style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-3 border d-flex align-items-center justify-content-center text-muted small"
                                             style="width: 60px; height: 60px; background-color: rgba(255, 255, 255, 0.03);">
                                            <i class="bi bi-image fs-4"></i>
                                        </div>
                                    }
                                </td>

                                <!-- Product Name -->
                                <td>
                                    <span class="fw-bold text-heading d-block">@p.Name</span>
                                    <small class="text-muted">ID: #@p.Id</small>
                                </td>

                                <!-- Category -->
                                <td>
                                    @if (p.Category != null)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            @p.Category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa phân loại</span>
                                    }
                                </td>

                                <!-- Price -->
                                <td class="text-end fw-bold luxury-accent">
                                    @p.Price.ToString("N0") VNĐ
                                </td>

                                <!-- Stock Status -->
                                <td class="text-center">
                                    @if (p.Stock > 10)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            @p.Stock
                                        </span>
                                    }
                                    else if (p.Stock > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            @p.Stock (Sắp hết)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            Hết hàng
                                        </span>
                                    }
                                </td>

                                <!-- Action Buttons -->
                                <td class="text-center pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-secondary"
                                           asp-controller="Product"
                                           asp-action="Details"
                                           asp-route-id="@p.Id"
                                           title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a class="btn btn-outline-primary"
                                           asp-controller="Product"
                                           asp-action="Edit"
                                           asp-route-id="@p.Id"
                                           title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a class="btn btn-outline-danger"
                                           asp-controller="Product"
                                           asp-action="Delete"
                                           asp-route-id="@p.Id"
                                           title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-box-seam fs-2 d-block mb-2"></i>
                                Không tìm thấy sản phẩm nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* <!-- Pagination Controls -->
        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="card-footer py-3 d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    Hiển thị trang <strong>@Model.PageNumber</strong> / <strong>@Model.TotalPages</strong> (Tổng <strong>@Model.TotalItems</strong> sản phẩm)
                </span>
                <nav aria-label="Product navigation">
                    <ul class="pagination pagination-sm m-0">
                        <!-- Nút Previous -->
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageNumber - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        <!-- Trang danh sách -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageIndex="@i">@i</a>
                            </li>
                        }

                        <!-- Nút Next -->
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageNumber + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        } *@
    </div>
</div>