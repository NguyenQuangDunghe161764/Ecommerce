@using Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ManagePermissionViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý quyền - " + Model.RoleName;
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h3 class="fw-bold mb-1 luxury-accent">
                <i class="bi bi-shield-check me-2"></i>Quản lý quyền hạn
            </h3>
            <span class="text-muted">Vai trò (Role): <strong class="text-heading fs-6">@Model.RoleName</strong></span>
        </div>
        <a asp-controller="Admin" asp-action="Roles" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Permissions == null || !Model.Permissions.Any())
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
            <div>Chưa có danh sách quyền (Permission) nào được khởi tạo cho vai trò này.</div>
        </div>
    }
    else
    {
        <form asp-action="ManageRolePermissions" asp-controller="Admin" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="RoleId" />

            <div class="card shadow-sm border-0 mb-4">

                <!-- Card Header with Toggle All -->
                <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-heading">Danh sách danh mục quyền</span>
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" id="selectAllToggle" />
                        <label class="form-check-label text-muted small fw-semibold" for="selectAllToggle">
                            Chọn tất cả
                        </label>
                    </div>
                </div>

                <!-- Card Body with Permissions Grid -->
                <div class="card-body p-4">
                    <div class="row g-3">
                        @for (int i = 0; i < Model.Permissions.Count; i++)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="p-3 border rounded-3 bg-transparent h-100 d-flex align-items-center">
                                    <div class="form-check m-0">
                                        <!-- Hidden Inputs -->
                                        <input type="hidden" asp-for="Permissions[i].PermissionId" />
                                        <input type="hidden" asp-for="Permissions[i].PermissionName" />

                                        <!-- Checkbox -->
                                        <input class="form-check-input permission-checkbox"
                                               type="checkbox"
                                               id="perm-@i"
                                               name="Permissions[@i].IsSelected"
                                               value="true"
                                        @(Model.Permissions[i].IsSelected ? "checked=\"checked\"" : "") />

                                        <label class="form-check-label ms-2 text-heading fw-medium user-select-none" for="perm-@i">
                                            @Model.Permissions[i].PermissionName
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Card Footer Actions -->
                <div class="card-footer p-3 d-flex justify-content-end gap-2">
                    <a asp-controller="Admin" asp-action="Roles" class="btn btn-outline-secondary px-4">
                        Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="bi bi-save me-1"></i> Lưu cấu hình quyền
                    </button>
                </div>

            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const $selectAll = $('#selectAllToggle');
            const $checkboxes = $('.permission-checkbox');

            // Kiểm tra trạng thái ban đầu của nút Select All
            function updateSelectAllState() {
                const total = $checkboxes.length;
                const checked = $checkboxes.filter(':checked').length;
                $selectAll.prop('checked', total > 0 && total === checked);
            }

            updateSelectAllState();

            // Toggle chọn tất cả / bỏ chọn
            $selectAll.change(function() {
                $checkboxes.prop('checked', $(this).is(':checked'));
            });

            // Khi một checkbox lẻ thay đổi
            $checkboxes.change(function() {
                updateSelectAllState();
            });
        });
    </script>
}